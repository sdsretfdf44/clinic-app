{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": ""
  },

  "Jwt": {
    "Issuer": "arrapa.clinicos.api",
    "Audience": "arrapa.clinicos.web",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Email": {
    "Provider": "Log",
    "FromEmail": "no-reply@arrapa.software",
    "FromName": "Arrapa ClinicOS",
    "WebBaseUrl": "http://localhost:5173",
    "PasswordResetUrlTemplate": "/reset-password?email={email}&token={token}&tenant={tenant}",
    "EmailVerificationUrlTemplate": "/verify-email?email={email}&token={token}&tenant={tenant}",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": ""
    }
  },

  "Database": {
    "SeedOnStart": false
  },

  "DataProtection": {
    "KeysDirectory": ""
  },

  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "GlobalPermitPerMinute": 300
  },

  "FileStorage": {
    "Provider": "LocalDisk",
    "LocalRootPath": "",
    "PublicBaseUrl": "/files",
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/pdf"
    ]
  },

  "Notifications": {
    "Enabled": false,
    "SchedulerIntervalSeconds": 300,
    "SendBookingConfirmation": true,
    "SendReminder24h": true,
    "SendReminder1h": true,
    "DefaultChannel": "WhatsApp",
    "WhatsApp": {
      "Provider": "",
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    },
    "Sms": {
      "Provider": "",
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/arrapa-clinicos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }
}
